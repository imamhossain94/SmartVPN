<?xml version="1.0" encoding="utf-8"?>
<!--
    Excludes the cached VPN server configurations from auto backup.
    See https://developer.android.com/guide/topics/data/autobackup
    This file is ignored on devices below API 31, which use
    res/xml/data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="MyPrefs.xml" />
</full-backup-content>
